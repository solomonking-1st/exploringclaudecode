# Local dev: a plain file, resolved to prisma/dev.db (see lib/prisma.ts).
# Production (Turso): a libsql:// URL from `turso db show <name> --url`,
# plus DATABASE_AUTH_TOKEN from `turso db tokens create <name>`.
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=

# Optional: once a Meta Developer App is approved for the oEmbed Read product,
# set this to enable Instagram/Facebook fetching. Until then, saves from those
# platforms are stored with fetchMethod=FAILED (source link + thumbnail only).
META_ACCESS_TOKEN=
